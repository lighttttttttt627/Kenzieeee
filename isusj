        <!-- Sweet Sparkle Shower -->
        <button onclick="burstHearts(event)" class="flex items-center gap-1.5 px-3.5 py-1.5 bg-gradient-to-r from-pink-400 to-rose-400 hover:from-pink-500 hover:to-rose-500 text-white rounded-full text-xs font-bold shadow-sm transition-all transform active:scale-95">
          <i data-lucide="heart" class="w-3.5 h-3.5 fill-white"></i>
